{
  "name": "coub-panel",
  "displayName": "Coub Panel",
  "description": "Watch Coubs in a VS Code panel with auto-advance and random discovery.",
  "version": "0.1.3",
  "publisher": "Entro",
  "repository": {
    "type": "git",
    "url": "https://github.com/entropious/coub_extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onView:coub-panel.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "coub-panel-container",
          "title": "Coub Player",
          "icon": "media/coub.svg"
        }
      ]
    },
    "views": {
      "coub-panel-container": [
        {
          "icon": "media/icon.png",
          "type": "webview",
          "id": "coub-panel.view",
          "name": "Coub Player",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "coub-panel.next",
        "title": "Next Coub",
        "icon": "$(chevron-right)",
        "category": "Coub"
      },
      {
        "command": "coub-panel.previous",
        "title": "Previous Coub",
        "icon": "$(chevron-left)",
        "category": "Coub"
      },
      {
        "command": "coub-panel.refresh",
        "title": "Refresh Feed",
        "icon": "$(refresh)",
        "category": "Coub"
      },
      {
        "command": "coub-panel.toggle-play",
        "title": "Toggle Play/Pause",
        "category": "Coub"
      },
      {
        "command": "coub-panel.toggle-claude-sync",
        "title": "Toggle Claude Sync",
        "category": "Coub"
      }
    ],
    "keybindings": [
      {
        "command": "coub-panel.toggle-play",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "view.coub-panel.view.visible"
      },
      {
        "command": "coub-panel.next",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "view.coub-panel.view.visible"
      },
      {
        "command": "coub-panel.previous",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "view.coub-panel.view.visible"
      },
      {
        "command": "coub-panel.toggle-claude-sync",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "view.coub-panel.view.visible"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "coub-panel.refresh",
          "when": "view.coub-panel.view.visible",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "coub-panel.next",
          "when": "view.coub-panel.view.visible"
        },
        {
          "command": "coub-panel.previous",
          "when": "view.coub-panel.view.visible"
        },
        {
          "command": "coub-panel.refresh",
          "when": "view.coub-panel.view.visible"
        },
        {
          "command": "coub-panel.toggle-play",
          "when": "view.coub-panel.view.visible"
        },
        {
          "command": "coub-panel.toggle-claude-sync",
          "when": "view.coub-panel.view.visible"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.19",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "mocha": "^11.3.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
